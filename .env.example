# Skinner 2.0 — exemplo de configuração local
# Copie este arquivo para .env e preencha apenas o que for necessário.
# Nunca publique o arquivo .env nem credenciais reais.

# -----------------------------------------------------------------------------
# Banco de dados — obrigatório para API/dashboard
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# bHave — obrigatórias somente para sincronização
# -----------------------------------------------------------------------------
BHAVE_API_KEY=
BHAVE_EMAIL=
BHAVE_PASSWORD=
BHAVE_ACCOUNT_ID=
BHAVE_REPORT_START_DATE=2026-01-01

# Segredo local para pseudonimização de identificadores.
# Gere um valor aleatório forte e mantenha apenas no .env local.
SKINNER_PATIENT_HASH_SALT=

# Limites e pausa da sincronização
SKINNER_MAX_JSON_BYTES=5000000
SKINNER_MAX_REPORT_BYTES=25000000
SKINNER_API_PAUSE_SECONDS=0.5

# -----------------------------------------------------------------------------
# Dashboard / API local
# -----------------------------------------------------------------------------
SKINNER_API_URL=http://127.0.0.1:8000
SKINNER_AGENT_TIMEOUT_SECONDS=300

# Caminho local do template DOCX usado no PEI
SKINNER_PEI_TEMPLATE_PATH=

# -----------------------------------------------------------------------------
# Base de conhecimento local
# -----------------------------------------------------------------------------
SKINNER_KNOWLEDGE_DIR=dados_clinica/base_conhecimento_md
SKINNER_KNOWLEDGE_PDF_DIR=dados_clinica/base_conhecimento_pdf
# Alternativa para múltiplos diretórios de PDF: use o separador de caminhos do SO.
SKINNER_KNOWLEDGE_PDF_DIRS=
SKINNER_KNOWLEDGE_CACHE_DIR=dados_clinica/.knowledge_cache

# -----------------------------------------------------------------------------
# Assistente de IA — tudo opcional
# Ordem padrão usada pelo código: gemini,openrouter,nvidia,groq
# -----------------------------------------------------------------------------
SKINNER_AI_PROVIDER_ORDER=gemini,openrouter,nvidia,groq

# Gemini
GEMINI_API_KEY=
GEMINI_API_KEYS=
SKINNER_GEMINI_API_KEYS=
SKINNER_GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
SKINNER_OPENAI_MODEL=gpt-4o-mini

# Groq
GROQ_API_KEY=
SKINNER_GROQ_MODEL=llama-3.1-8b-instant

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEY=
SKINNER_NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# OpenRouter
OPENROUTER_API_KEY=
SKINNER_OPENROUTER_MODEL=openrouter/free
SKINNER_OPENROUTER_SITE_URL=http://127.0.0.1:8501
SKINNER_OPENROUTER_APP_NAME=Skinner Project

# Anthropic — só é usado se for incluído em SKINNER_AI_PROVIDER_ORDER
ANTHROPIC_API_KEY=
SKINNER_ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_VERSION=2023-06-01
